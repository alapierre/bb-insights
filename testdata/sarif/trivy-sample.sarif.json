{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "rules": [
            {
              "id": "CVE-2021-3711",
              "name": "CVE-2021-3711",
              "shortDescription": {"text": "OpenSSL buffer overflow"},
              "properties": {
                "tags": ["vulnerability", "security", "CRITICAL"],
                "security-severity": "9.8"
              }
            },
            {
              "id": "CVE-2022-9999",
              "name": "CVE-2022-9999",
              "shortDescription": {"text": "curl heap overflow"},
              "properties": {
                "tags": ["vulnerability", "security"],
                "security-severity": "5.5"
              }
            },
            {
              "id": "CVE-2020-1111",
              "name": "CVE-2020-1111",
              "shortDescription": {"text": "busybox minor issue"}
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-3711",
          "level": "error",
          "message": {
            "text": "Package: openssl\nInstalled Version: 1.1.1f-1ubuntu2.19\nVulnerability CVE-2021-3711\nSeverity: CRITICAL\nFixed Version: 1.1.1f-1ubuntu2.20"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "usr/lib/x86_64-linux-gnu/libcrypto.so.1.1"},
                "region": {"startLine": 1}
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2022-9999",
          "level": "warning",
          "message": {
            "text": "Package: curl\nInstalled Version: 7.68.0\nVulnerability CVE-2022-9999\nSeverity: MEDIUM\nFixed Version: 7.68.1"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "usr/bin/curl"},
                "region": {"startLine": 1}
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2020-1111",
          "level": "note",
          "message": {
            "text": "Package: busybox\nVulnerability CVE-2020-1111\nSeverity: LOW"
          }
        }
      ]
    }
  ]
}
